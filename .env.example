# Default compose.yaml: integrated Browser Activity, no DEV_TOKEN or PS1 required.
# Generate TWO different secrets: docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Copy BROWSER_INTEGRATION_KEY to the backend .env as well. Never put it in VITE_*.
BROWSER_INTEGRATION_KEY=
BROWSER_LIVEKIT_SECRET=
BROWSER_LIVEKIT_PORT=48034
BROWSER_LIVEKIT_UDP_PORT=48035
# ICE candidate advertised to clients. 127.0.0.1 is local-only; deployments use the routable server IPv4.
BROWSER_LIVEKIT_NODE_IP=127.0.0.1
# Host interface for ICE ports; keep loopback locally and bind a routable interface only with matching firewall rules.
BROWSER_LIVEKIT_BIND_ADDRESS=127.0.0.1

# Existing backend Docker network and exact frontend origin (without trailing /).
ZVONOK_CORE_NETWORK=zvonok-net
BROWSER_UI_ORIGIN=http://localhost:3000

# 720p15, 720p30, 720p60, 1080p30, 1080p60; higher FPS requires more CPU.
BROWSER_MEDIA_PROFILE=720p15
BROWSER_AUDIO=1
SESSION_IDLE_MS=300000
SESSION_TTL_MS=1200000

# Optional: change all three together if this subnet is occupied.
BROWSER_SUBNET=172.30.87.0/24
BROWSER_PROXY_IP=172.30.87.2
BROWSER_GUARD_IP=172.30.87.3

# Legacy PNG demo only (docker compose -f compose.poc.yaml ...).
# DEV_TOKEN=
# BROWSER_PORT=47831
